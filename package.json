{
  "name": "energy-info-hub",
  "version": "1.0.0",
  "description": "能源/储能/AIDC 信息聚合导航站 - 纯静态 + GitHub Actions 自动抓 RSS",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-rss.mjs",
    "fetch:daily": "node scripts/fetch-rss.mjs --mode=daily",
    "check": "node scripts/check-sources.mjs",
    "samples": "node scripts/extract-samples.mjs --days=7",
    "annotate": "node scripts/build-annotation-set.mjs",
    "analyze": "node scripts/analyze-annotations.mjs",
    "baseline": "node scripts/build-baseline.mjs",
    "eval:filter": "node scripts/eval-filter.mjs",
    "build:v2": "node scripts/build-daily-v2.mjs",
    "build:v2:replay": "node scripts/build-daily-v2.mjs --replay",
    "validate": "node scripts/validate-data.mjs",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "verify": "npm test && npm run validate && node --check assets/app.js",
    "preview": "npx --yes serve . -l 5173",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
